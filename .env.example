# Copy to .env.local and fill in. Never commit real values.

# Postgres — local: `docker compose up -d` gives you this URL; prod: Neon pooled connection string
DATABASE_URL=postgres://intelliprompt:intelliprompt@localhost:5432/intelliprompt

# Clerk — https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk → Webhooks → endpoint /api/webhooks/clerk (events: user.created, user.updated, user.deleted)
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/prompts
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/prompts

# OpenRouter — https://openrouter.ai/keys (set a monthly credit limit on the key)
OPENROUTER_API_KEY=
# Optional: comma-separated backup keys you own, used only if the primary fails (revoked/out of credit)
OPENROUTER_FALLBACK_KEYS=

# Public URL of the app (used in email links)
APP_URL=http://localhost:3000

# Email — Redis for the BullMQ queue (local: docker compose gives redis://localhost:6380; prod: Upstash rediss:// URL)
REDIS_URL=redis://localhost:6380
# Resend — https://resend.com/api-keys ; EMAIL_FROM must use a domain verified in Resend
RESEND_API_KEY=
EMAIL_FROM="IntelliPrompt <hello@example.com>"
# Long random string; signs unsubscribe links (e.g. `openssl rand -base64 32`)
UNSUBSCRIBE_SECRET=

# Razorpay — https://dashboard.razorpay.com/app/keys (use test keys until launch)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → <APP_URL>/api/webhooks/razorpay, events: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=
